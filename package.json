{
  "name": "life-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node scripts/test-model.mjs && node scripts/test-cloud-model.mjs && node scripts/test-dashboard.mjs && node scripts/test-calendar-dates.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-life-lab \"node scripts/test-firestore-rules.mjs\"",
    "test:cloud-browser": "firebase emulators:exec --only auth,firestore --project demo-life-lab \"node scripts/test-browser-firebase.mjs\"",
    "test:account-deletion": "firebase emulators:exec --only auth,firestore --project demo-life-lab \"node scripts/test-account-deletion.mjs\"",
    "test:account-flow": "firebase emulators:exec --only auth,firestore --project demo-life-lab \"node scripts/test-account-flow.mjs\""
  },
  "dependencies": {
    "firebase": "12.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
