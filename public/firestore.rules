rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validExperiment() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'hypothesis', 'a', 'b', 'days', 'start', 'metric', 'unit', 'max', 'category', 'entries', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['title', 'hypothesis', 'a', 'b', 'days', 'start', 'metric', 'unit', 'max', 'category', 'entries', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.hypothesis is string && d.hypothesis.size() <= 300
        && d.a is string && d.a.size() > 0 && d.a.size() <= 40
        && d.b is string && d.b.size() > 0 && d.b.size() <= 40
        && d.days in [7, 10, 14, 21, 28]
        && d.start is string && d.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.metric is string && d.metric.size() > 0 && d.metric.size() <= 30
        && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 10
        && d.max is number && d.max >= 1 && d.max <= 10000
        && d.category is string && d.category.size() > 0 && d.category.size() <= 30
        && d.entries is map && d.entries.size() <= d.days
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid}/experiments/{experimentId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validExperiment() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validExperiment()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
